FROM apache/airflow:3.2.0-python3.12

USER root

# python-mecab-ko 는 pip install 시 mecab-ko 를 소스에서 빌드한다.
# 빌드 도구만 설치하면 pip 가 알아서 처리.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential \
      automake \
      autoconf \
      libtool \
      curl \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

USER airflow

# python-mecab-ko 포함. DAG/작업 런타임 의존 일부도 미리 넣어둠.
RUN pip install --no-cache-dir \
      "python-mecab-ko>=1.3.7" \
      "psycopg[binary]>=3.2" \
      "httpx>=0.28" \
      "pyyaml>=6.0" \
      "apache-airflow-providers-common-sql" \
      "apache-airflow-providers-postgres"
